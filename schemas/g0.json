{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_evaluated",
    "action",
    "checks",
    "reason",
    "evidence_loc",
    "expected_reference_spec",
    "regenerated_task_new",
    "issues",
    "task_card"
  ],
  "properties": {
    "job_evaluated": { "type": "string", "maxLength": 100 },
    "action": { "type": "string", "enum": ["KEEP", "REGENERATE", "REVIEW_B", "RESELECT_B"] },
    "checks": { "$ref": "#/$defs/checks" },
    "reason": { "type": "string", "maxLength": 300 },
    "evidence_loc": { "type": "string", "maxLength": 300 },
    "expected_reference_spec": { "type": "string", "maxLength": 500 },
    "regenerated_task_new": { "type": ["string", "null"], "maxLength": 1000 },
    "issues": { "$ref": "#/$defs/issues" },
    "task_card": { "anyOf": [{ "$ref": "#/$defs/task_card" }, { "type": "null" }] }
  },
  "$defs": {
    "check_status": { "type": "string", "enum": ["P", "R", "F", "NA"] },
    "issue_text": { "type": ["string", "null"], "maxLength": 200 },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_fit",
        "deliverable_fit",
        "grounding",
        "input_contract",
        "reasoning_validity",
        "reconstructability",
        "no_answer_leakage",
        "no_external_search",
        "reference_burden",
        "output_specification"
      ],
      "properties": {
        "job_fit": { "$ref": "#/$defs/check_status" },
        "deliverable_fit": { "$ref": "#/$defs/check_status" },
        "grounding": { "$ref": "#/$defs/check_status" },
        "input_contract": { "$ref": "#/$defs/check_status" },
        "reasoning_validity": { "$ref": "#/$defs/check_status" },
        "reconstructability": { "$ref": "#/$defs/check_status" },
        "no_answer_leakage": { "$ref": "#/$defs/check_status" },
        "no_external_search": { "$ref": "#/$defs/check_status" },
        "reference_burden": { "$ref": "#/$defs/check_status" },
        "output_specification": { "$ref": "#/$defs/check_status" }
      }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_fit",
        "deliverable_fit",
        "grounding",
        "input_contract",
        "reasoning_validity",
        "reconstructability",
        "no_answer_leakage",
        "no_external_search",
        "reference_burden",
        "output_specification"
      ],
      "properties": {
        "job_fit": { "$ref": "#/$defs/issue_text" },
        "deliverable_fit": { "$ref": "#/$defs/issue_text" },
        "grounding": { "$ref": "#/$defs/issue_text" },
        "input_contract": { "$ref": "#/$defs/issue_text" },
        "reasoning_validity": { "$ref": "#/$defs/issue_text" },
        "reconstructability": { "$ref": "#/$defs/issue_text" },
        "no_answer_leakage": { "$ref": "#/$defs/issue_text" },
        "no_external_search": { "$ref": "#/$defs/issue_text" },
        "reference_burden": { "$ref": "#/$defs/issue_text" },
        "output_specification": { "$ref": "#/$defs/issue_text" }
      }
    },
    "task_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "operations", "criteria", "output"],
      "properties": {
        "input": { "type": "string", "maxLength": 300 },
        "operations": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 200 }
        },
        "criteria": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 200 }
        },
        "output": { "type": "string", "maxLength": 300 }
      }
    }
  }
}
